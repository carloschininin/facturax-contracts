{
    "name": "carloschininin/facturax-contracts",
    "description": "Contratos DTO versionados y bundle Symfony opcional para la API de Facturax.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "phpdocumentor/reflection-docblock": "^5.6",
        "php": "^8.3",
        "symfony/config": "^7.1|^8.0",
        "symfony/dependency-injection": "^7.1|^8.0",
        "symfony/http-kernel": "^7.1|^8.0",
        "symfony/property-info": "^7.1|^8.0",
        "symfony/serializer": "^7.1|^8.0",
        "symfony/validator": "^7.1|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "CarlosChininin\\FacturaxContracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CarlosChininin\\FacturaxContracts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
